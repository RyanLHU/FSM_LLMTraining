# Default: works without any model or API key.
RAG_PROVIDER=extractive

# Local generation option:
# RAG_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Any OpenAI-compatible Chat Completions API:
# RAG_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=your-model-id
# OPENAI_COMPATIBLE_BASE_URL=https://your-provider.example/v1

# Backward compatible: RAG_PROVIDER=openai with OPENAI_API_KEY,
# OPENAI_MODEL and OPENAI_BASE_URL continues to work.

# Optional: use Node's native fetch for DSAJ instead of the robust default curl transport.
# DSAJ_HTTP_TRANSPORT=fetch

# Web server (defaults shown):
# HOST=127.0.0.1
# PORT=3000
